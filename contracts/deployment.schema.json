{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "版本上线",
  "description": "规则集或模型新版本上线登记，指标围绕上线时点前后对比。",
  "type": "object",
  "required": ["deployments"],
  "properties": {
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "deployment_id",
          "kind",
          "version",
          "launched_at",
          "pre_window_days",
          "post_window_days"
        ],
        "properties": {
          "deployment_id": {"type": "string", "minLength": 1},
          "kind": {
            "type": "string",
            "enum": ["rule", "model", "hybrid"]
          },
          "version": {"type": "string", "minLength": 1},
          "launched_at": {"type": "string", "format": "date-time"},
          "pre_window_days": {"type": "integer", "minimum": 1},
          "post_window_days": {"type": "integer", "minimum": 1},
          "change_summary": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
