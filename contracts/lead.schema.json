{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "命中线索反馈",
  "description": "每条核查线索在治理后台中的反馈记录，保存触发来源、输入水位、分派范围、核查阶段与结构化结论。",
  "type": "object",
  "required": [
    "lead_id",
    "subject_ref",
    "region_code",
    "trigger",
    "input_watermark",
    "dispatch",
    "stage",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "lead_id": {
      "type": "string",
      "minLength": 1,
      "description": "线索全局唯一标识"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1,
      "description": "被核查主体的假名化引用，不存真实姓名/证件号"
    },
    "region_code": {
      "type": "string",
      "pattern": "^[0-9]{6}$",
      "description": "承办区域行政区划代码"
    },
    "cross_region_group": {
      "type": ["string", "null"],
      "description": "跨区域重复线索归并组标识；同组只有一条由主办区域裁决，其余在裁决前为待定重复"
    },
    "trigger": {
      "type": "object",
      "required": ["kind", "version", "rule_ids"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["rule", "model", "hybrid"]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "规则集版本（如 ruleset-2026.07）或模型版本（如 riskmodel-v4）"
        },
        "rule_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "model_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "input_watermark": {
      "type": "object",
      "required": ["as_of", "source_snapshots"],
      "description": "触发时输入数据的水位，保证同版本结论可复现",
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "source_snapshots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source", "snapshot_id"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "snapshot_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "dispatch": {
      "type": "object",
      "required": ["scope", "regions", "dispatched_at"],
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["national", "regional", "special"]
        },
        "regions": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9]{6}$"}
        },
        "dispatched_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "string",
      "enum": [
        "new",
        "assigned",
        "checking",
        "concluded",
        "appealed",
        "closed"
      ],
      "description": "new/assigned/checking 属尚未结案；concluded 后仍可能经申诉进入新版本"
    },
    "conclusion": {
      "type": ["object", "null"],
      "description": "结构化结论，仅在阶段推进到 concluded/appealed/closed 时存在",
      "required": ["outcome", "reason_codes", "decided_at"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "violation_filed",
            "violation_unfiled",
            "legal_exception",
            "insufficient_evidence",
            "data_error",
            "rule_self_proof",
            "duplicate_pending",
            "pending"
          ],
          "description": "violation_filed=立案；violation_unfiled=违法未立案；legal_exception=合法例外；insufficient_evidence=证据暂缺；data_error=数据错误；rule_self_proof=规则自证；duplicate_pending=跨区域重复待裁决；pending=尚未完成"
        },
        "reason_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "narrative": {"type": ["string", "null"]},
        "decided_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
